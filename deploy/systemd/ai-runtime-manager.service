[Unit]
Description=AI Runtime Manager
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
User=manfred
Environment=PATH=/home/manfred/ai-local/services/manager/venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/manfred/ai-local/services/manager
ExecStart=/home/manfred/ai-local/services/manager/venv/bin/python3 /home/manfred/ai-local/services/manager/venv/bin/uvicorn main:app --host 0.0.0.0 --port 18500
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
